# ClientPulse Environment Configuration
# Copy this file to .env and adjust variables for your local setup.
# Never commit .env or real secrets to version control.

# Application Environment
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=UTC

# Local Docker Host Ports (avoids port collisions)
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5433
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Database Configuration
POSTGRES_USER=clientpulse
POSTGRES_PASSWORD=clientpulse_dev_password
POSTGRES_DB=clientpulse
DATABASE_URL=postgres://clientpulse:clientpulse_dev_password@postgres:5432/clientpulse?sslmode=disable
DATABASE_URL_HOST=postgres://clientpulse:clientpulse_dev_password@localhost:5433/clientpulse?sslmode=disable

# Security Keys & Cryptographic Peppers (Use 32+ characters in production)
SESSION_SECRET=dev-session-secret-replace-with-cryptographic-random-value-in-prod
TOKEN_HASH_PEPPER=dev-token-pepper-replace-with-cryptographic-random-value-in-prod

# Telegram Integration (Leave empty to mark feature as Unconfigured)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Email Provider (none, smtp, mailpit)
EMAIL_PROVIDER=none
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=notifications@clientpulse.local

# Storage Provider (local, s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/data/storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Billing Provider (manual in MVP)
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=

# Worker & Monitoring Engine Parameters
WORKER_CONCURRENCY=10
MONITOR_DEFAULT_INTERVAL_SECONDS=300
MONITOR_DEFAULT_TIMEOUT_SECONDS=10
CHECK_RESULT_RETENTION_DAYS=90

# Initial Platform Admin Seed (Development only)
PLATFORM_ADMIN_EMAIL=admin@clientpulse.local
PLATFORM_ADMIN_PASSWORD=dev-admin-password-change-me

